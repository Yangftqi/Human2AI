{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Human2AI",
  "version": "1.0.0",
  "identifier": "com.human2ai.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Human2AI - AI八股嘴替工坊",
        "url": "index.html#/studio",
        "width": 1080,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
